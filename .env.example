# lume-lan .env — 路由器 / 扫描配置（本文件 gitignore，勿提交）
# 用法：cp .env.example .env 后填值。所有变量都有默认，留空即走默认。

# 路由器后台地址（默认 192.168.3.1）
ROUTER_HOST=192.168.3.1

# 路由器登录凭据（用于抓「终端管理/流量」等登录态数据；只本地使用）
ROUTER_USER=admin
ROUTER_PASS=

# 终端列表/流量：填了 ROUTER_PASS 后，router_fetch.py 会自动登录（SHA256 简单路径，
# 独立于网页 SCRAM 的限流计数）并直接读 /api/system/HostInfo，无需手动抓端点。
# 无需配置，留空即可。

# 可选：是否启用 ping sweep（=1 时 scan_lan 会扫网关所在 /24 全段，较慢）
LAN_SWEEP=0

# ---- 告警推送（可选，不配则告警只打印到 make router-fetch 日志）----
# 机器人 webhook。钉钉: 群设置 → 智能群助手 → 添加机器人(自定义) → 复制 webhook;
#   安全设置选「加签」→ 把 SEC 开头那串填 WEBHOOK_SECRET;
#   选「自定义关键词」→ 把 "lume-lan" 加进关键词, WEBHOOK_SECRET 留空。
# 也兼容企业微信 / Server酱(它们不校验 sign, SECRET 留空即可)。
# 告警内容: 新设备进网 / WAN 状态跳变 / 单设备近 1h 流量 >=10GB(30min 去重)。
# 状态落 .data/alert_state.json(首次静默建基线); 测试: make notify-test。
WEBHOOK_URL=
WEBHOOK_SECRET=
