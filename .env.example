# lume-lan .env — 路由器 / 扫描配置（本文件 gitignore，勿提交）
# 用法：cp .env.example .env 后填值。所有变量都有默认，留空即走默认。

# 路由器后台地址。留空 = 自动取 .data/devices.json 的 gateway(宿主 arp 扫出的真实网关),
# 换网段/换路由器不用改配置; 需要锁定时再显式填写(如 192.168.1.1)。
ROUTER_HOST=

# 路由器登录凭据（用于抓「终端管理/流量」等登录态数据；只本地使用）
ROUTER_USER=admin
ROUTER_PASS=

# 终端列表/流量：填了 ROUTER_PASS 后，router_fetch.py 会自动登录（SHA256 简单路径，
# 独立于网页 SCRAM 的限流计数）并直接读 /api/system/HostInfo，无需手动抓端点。
# 无需配置，留空即可。

# 可选：是否启用 ping sweep（=1 时 scan_lan 会扫网关所在 /24 全段，较慢）
LAN_SWEEP=0

# 异常流量告警阈值（GB/近 1h，默认 10）：单设备近 1h 流量超过此值，面板标「谁在猛传」+ 推送告警。
LAN_ANOMALY_GB=10

# ---- 告警推送（可选，不配则告警只打印到 make router-fetch 日志）----
# 机器人 webhook。钉钉: 群设置 → 智能群助手 → 添加机器人(自定义) → 复制 webhook;
#   安全设置选「加签」→ 把 SEC 开头那串填 WEBHOOK_SECRET;
#   选「自定义关键词」→ 把 "lume-lan" 加进关键词, WEBHOOK_SECRET 留空。
# 也兼容企业微信 / Server酱(它们不校验 sign, SECRET 留空即可)。
# 告警内容: 新设备进网 / WAN 状态跳变 / 单设备近 1h 流量 >=10GB(30min 去重)。
# 状态落 .data/alert_state.json(首次静默建基线); 测试: make notify-test。
WEBHOOK_URL=
WEBHOOK_SECRET=

# 关键设备 IP(逗号分隔): 这些设备 在线→离线 跳变时推「⚠️ 关键设备离线」,
# 上线时推「✅ 恢复在线」。填家里不能掉线的: NAS / 主 PC / 打印机 等, 如
#   CRITICAL_IPS=192.168.1.20,192.168.1.30
# 不填则关闭该告警(其余三类照常)。
CRITICAL_IPS=

# 日报: 数据循环每 24h 自动推一条(make daily-digest 可手动强推)。
# 自动节奏, 无需配置; 没配 WEBHOOK_URL 则只打印不推。

# AdGuard Home(DNS 记录「谁访问了什么域名」): 已迁到 Mac 宿主 launchd 服务,
# 起停用 make adguard-up / make adguard-down(详见 Makefile 注释)。
# 把家里设备 DNS「首选」指 <本机IP>:53(AdGuard)、「备用」填 223.5.5.5。
# 本机没跑 AdGuard 时 make dns-fetch 不报错(降级标记 stale), 面板显示「未连接」。
# 控制台/API 端口: 宿主服务直绑 ADGUARD_PORT(默认 10095, >10000)。
ADGUARD_HOST=127.0.0.1
ADGUARD_PORT=10095

# ---- 跨机 peer 通讯(两台机器上的 lume agent 互相调用)----
# 留空 PEER_SHARED = 整个 /peer/* 面关闭(默认安全); 配了才会开放。
# 生成密钥: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
PEER_SHARED=
# 本节点名(会出现在对端日志与响应里, 只用于识别, 不参与鉴权)
PEER_NAME=lume-node
# 本节点监听地址。跨机必须 0.0.0.0(绑 127.0.0.1 只有本机可连)
PEER_BIND=0.0.0.0
PEER_PORT=18092
# 对端地址(仅 peer_probe 用): IP:端口
PEER_HOST=
# 时间戳容差(秒), 防重放窗口; 两台机器时钟偏差超过它就全被拒
PEER_SKEW_SECS=120
# 本机 agent-httpd 的地址(/peer/ask 会把提问转发给它)。
# 留空 = http://127.0.0.1:18099; 没跑 agent-httpd 时 /peer/ask 返回
# {ok:false, error:"agent 不可达: ..."}, 不是静默空答案。
AGENT_URL=
# 单次 agent 回答的总超时(秒)。lume 是「收完整个 SSE 才返回」, 长回答要给够。
AGENT_TIMEOUT=90

# ---- agent 自动发现 peer 能力(MCP 桥) ----
# scripts/peer_bridge.py 是一个 stdio MCP server: agent-httpd 拉起它后,
# agent 每轮 tools/list 都能看到「局域网里所有 peer 节点的工具」, 并自己决定
# 调哪个。新增一个 lume-* 应用只需要它起自己的 peer_node.lume, 本桥不用改代码。
#
# 接入方式: 在 agent-httpd 的 .data/mcp-servers.json 加一项:
#   {"id":"peers","transport":"stdio","command":"python3",
#    "args":"<此仓库>/scripts/peer_bridge.py","approval":false}
# 并给 agent-httpd 的进程环境注入 PEER_SHARED / PEER_TARGETS。
#
# 暴露策略:
#   readonly(默认) 只暴露只读工具; 写/删除/创建类按名字过滤掉,
#                  并在工具表里附一条 _peers__blocked 说明被拦了什么
#   all            暴露全部(风险自担: 等于让 agent 跨节点任意执行)
#   k1,k2          白名单: 只暴露名字里含 k1 或 k2 的工具
PEER_EXPOSE=readonly

# ---- A2A 兼容(标准客户端可发现) ----
# Agent Card 里的对外地址。A2A 客户端会**拿这个 url 直接发请求**, 所以必须
# 是客户端真正可达的地址, 不是节点绑定地址。
#   跨机访问: PEER_BIND=0.0.0.0 + PEER_PUBLIC_URL=http://<本机LAN IP>:<端口>
#   仅本机:   留空即可(自动回落成 http://127.0.0.1:<端口>)
# 配了但和绑定不一致时, Agent Card 会带一条 warnings 字段提示 —— 否则客户端
# 会 ConnectionRefused 而 card 看起来一切正常, 极难排查。
PEER_PUBLIC_URL=
