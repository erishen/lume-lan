// lan.lume — 局域网设备看板入口:server{} + HTTP 路由
//
// 启动: lume lan.lume  → http://127.0.0.1:8091   (lume = release, 默认 ~/.local/bin/lume)
//   /               仪表盘(React SPA,设备列表 + 摘要)
//   GET /api/devices  当前快照设备列表(读 .data/devices.json,宿主 make scan 刷新)
//
// 架构:lume-core 无 exec/子进程内置,「取设备」的真实系统调用(arp/ping)放宿主
// 脚本 scripts/scan_lan.py(产出 .data/devices.json 快照),本 .lume 侧只做
// HTTP 服务 + 读快照 + 交给 React 展示。刷新靠 `make scan`(宿主),浏览器再拉
// /api/devices 即见最新。

// bind 可经 env 覆盖(容器传 LUME_BIND=0.0.0.0);本地默认仍绑 127.0.0.1。
let lan_bind = env("LUME_BIND");
if (lan_bind == null) { lan_bind = "127.0.0.1"; }
server {
  port = 8091;
  workers = 2;
  bind = lan_bind;
  docroot = "./www";
  spa = true;        // SPA history 路由:GET + Accept:text/html + 静态 404 → 回 index.html
  htpasswd = env("HTPASSWD_FILE");  // 本地留空=无认证;公网注入即开 Basic Auth
};

// 领域层:读快照 + 组装响应(import 时不建库,纯无状态;快照文件由宿主 make scan 产出)
import "src/devices.lume" as lantbl;

// 审批写路径(看板唯一的写操作)。规则与边界见 src/approve_route.lume。
// 与 /api/peers 的只读不同, 这条会签名后打执行方的 /a2a, 所以需要容器里有
// PEER_NAME(我是谁) 与 PEER_ROOT / PEER_SHARED(怎么签)。缺任何一个都明确报错,
// 不会静默降级成"匿名批准"。
import "src/approvals.lume" as approvals;
import "src/approve_route.lume" as approve_route;
// 应用互访的「操作」入口: 调工具 / 问 agent(见 src/peer_actions.lume)。
import "src/peer_actions.lume" as peer_actions;

// 设备列表:读 .data/devices.json(缺失 → 空表 + 提示,不 500)。
get "/api/devices", (req) => {
  return lantbl.devices_payload();
};

// 元信息:网关 / 网段 / 快照时间 / 是否过期(前端据此显示「已过期,请 make scan」)。
get "/api/meta", (req) => {
  return lantbl.meta_payload();
};

// 路由器后台信息:读 .data/router.json(宿主 make router-fetch 产出)。
// router.ok=true 时 model/serial/厂商可用;router_devices 为登录态抓到的终端/流量
// (HiLink 私有端点,未命中则为空,前端据 terminal_source 与长度决定是否显示)。
get "/api/router", (req) => {
  return lantbl.router_payload();
};

// 每设备流量历史({ip: 近 5h 累计序列})——惰性单独端点, 前端点选设备看它自己曲线。
get "/api/router-traffic", (req) => {
  return lantbl.router_traffic_payload();
};

// DNS 域名访问记录:读 .data/dns.json(宿主 make dns-fetch 轮询 AdGuard Home 产出)。
// reachable=false 时前端显示「AdGuard 未连接」, 但旧数据仍可用(降级)。
get "/api/dns", (req) => {
  return lantbl.dns_payload();
};

// 可互访的 lume peer 节点:读 .data/peers.json(宿主 scripts/peers_fetch.py 探测产出)。
// 探测为什么不在容器里跑: 容器在 Docker NAT 网段, 连不到宿主 loopback 的 peer 端口,
// 且 PEER_SHARED 不该进容器环境 —— 与 scan_lan.py 同一套「谁有权限谁采集」。
get "/api/peers", (req) => {
  return lantbl.peers_payload();
};

// 注册窗口关闭,开始伺服(与 crm.lume 同款——server{} 定义好路由后必须显式 run())。
run();
