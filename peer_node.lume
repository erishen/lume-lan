// peer_node.lume — 跨机 peer 节点服务端(两台机器各起一个)
//
// 启动(节点 B):
//   PEER_SHARED=<共享密钥> PEER_NAME=nodeB PEER_BIND=0.0.0.0 PEER_PORT=18092 \
//     ~/.local/bin/lume peer_node.lume
//
// 端点(全部需签名; 未配 PEER_SHARED 时整面关闭):
//   GET  /peer/health   健康与身份
//   GET  /peer/tools    本节点能力清单
//   POST /peer/ask      接收对端提问(body 参与签名)
//
// 说明: lume 的 route handler **读不到请求头**, 所以认证参数走 query
// (node/ts/nonce/sig), 详见 ../lume-core/lib/peer.lume 文件头。
// peer 模块已下沉到 lume-core(../lume-core/lib/peer.lume)
import "../lume-core/lib/peer.lume" as peer;
import "src/peer/agent.lume" as agent;
import "src/a2a.lume" as a2a;
import "src/a2a_tasks.lume" as tasks;
import "src/peer_tool_policy.lume" as policy;

let bind_addr = env("PEER_BIND");
if (bind_addr == null) { bind_addr = "127.0.0.1"; }
let port_s = env("PEER_PORT");
if (port_s == null) { port_s = "18092"; }

server {
  port = int(port_s);
  workers = 2;
  bind = bind_addr;
};

// 启动自检：把"实际生效的签名模式"打到日志。配了两套凭据时(历史遗留很常见)
// 不主动看 health 就分不清用的是哪一套 —— 拿错算法签名会一路 401, 现象像密钥错。
if (len(peer.config_warnings()) > 0) {
  print("[peer] signature mode: " + peer.key_mode());
  let wi = 0;
  while (wi < len(peer.config_warnings())) {
    print("[peer] WARN " + str(get(peer.config_warnings(), wi, "")));
    wi = wi + 1;
  }
}


get "/peer/health", (req) => {
  let v = peer.verify(req, "GET", "GET " + peer.path_only(req.path));
  if (!get(v, "ok", false)) {
    return { ok: false, unauthorized: true, error: get(v, "error", "") };
  }
  return {
    ok: true,
    node: peer.node_info()["name"],
    peer: get(v, "node", ""),
    ts: int(now()),
    // 实际生效的签名模式。配了两套凭据时(历史遗留很常见), 不看这个就分不清
    // 到底是 ROOT 派生还是共享密钥在起作用 —— 拿错算法签名会一路 401。
    mode: peer.key_mode(),
    // 配置自检：空数组 = 没问题。非空说明有配置被静默忽略了。
    warnings: peer.config_warnings(),
  };
};

get "/peer/tools", (req) => {
  let v = peer.verify(req, "GET", "GET " + peer.path_only(req.path));
  if (!get(v, "ok", false)) {
    return { ok: false, unauthorized: true, error: get(v, "error", "") };
  }
  // 真实工具清单来自本机 agent-httpd 的 MCP 注册表; agent 没起时降级为空清单 + 错误说明
  let t = agent.list_tools();
  let raw = get(t, "tools", []);
  // 给每个工具补 when_to_use(能力层): 没有它 agent 只能看名字猜, 实测会退化成
  // 用 fs 工具乱翻文件。这里按工具名前缀给一个粗粒度提示, 够用且不用逐工具维护。
  let out = [];
  let i = 0;
  while (i < len(raw)) {
    let d = get(raw, i, {});
    let nm = str(get(d, "name", ""));
    // 标注 peer 面的可用性。**不隐藏**被拒的工具:
    //   - 隐藏会让"为什么调不通"变成谜(对端压根不知道有这个工具);
    //   - 标注则让调用方在编排阶段就能排除, 不必靠失败重试去发现。
    // 拒绝理由复用同一份 policy, 保证清单与执行不会各说各话。
    let why = policy.deny_reason(nm);
    let hint = when_hint(nm);
    // 被策略拒绝的工具, 提示语要**说清楚它调不通**, 而不是让"慎用"这种措辞
    // 把人引向"能用但要小心"。agent 读的是 when_to_use, 措辞会直接改变它的
    // 决策: 写"慎用"它仍会尝试, 写"不可调用"它才会避开。
    if (len(why) > 0) {
      hint = "peer 面不可调用（" + why + "）。本机 agent 内部仍可用。";
    }
    push(out, {
      name: nm,
      "server": str(get(d, "server", "")),
      desc: str(get(d, "desc", "")),
      "when_to_use": hint,
      // true = 可经 /peer/invoke 调用; false = 本机可用但对端不可调
      "peer_callable": len(why) == 0,
      "peer_blocked_reason": why,
    });
    i = i + 1;
  }
  return {
    ok: get(t, "ok", false),
    node: peer.node_info()["name"],
    summary: "局域网设备看板 + 本机 agent 的工具集。查局域网设备/流量/DNS 时用 lan.*;" +
             "查本机文件、记忆、投资体检时用 fs/memory/portfolio-check 等。",
    tools: out,
    error: get(t, "error", ""),
    agent_status: get(t, "status", 0),
  };
};

// 按工具名前缀给「什么时候用」的提示。返回空串表示没有专门提示, 调用方退到 desc。
func when_hint(nm: string) {
  if (len(str_match("^fs__read|^fs__list|^fs__search|^fs__get|^fs__directory", nm)) > 0) {
    return "需要读本机文件内容/目录结构时用。只读。";
  }
  if (len(str_match("^fs__write|^fs__edit|^fs__create|^fs__move", nm)) > 0) {
    return "需要改本机文件时用。写操作, 慎用。";
  }
  if (len(str_match("^memory__read|^memory__search|^memory__open", nm)) > 0) {
    return "需要回忆之前记住的东西时用。";
  }
  if (len(str_match("^memory__", nm)) > 0) {
    return "需要写入/修改长期记忆时用。";
  }
  if (len(str_match("^echo__", nm)) > 0) {
    return "纯连通性测试, 回显输入。";
  }
  if (len(str_match("^portfolio-check", nm)) > 0) {
    return "做投资前数据体检时用(只读、无副作用)。";
  }
  if (len(str_match("^pse-review", nm)) > 0) {
    return "要生成投资复盘周报时用。耗时 3-10 分钟。";
  }
  if (len(str_match("^think__", nm)) > 0) {
    return "需要多步推理时用。";
  }
  return "";
};

// 执行本节点的一个 MCP 工具。body: {"tool":"<name>","arguments":{...}}
// 注意: 这是**写/执行**类操作, 签名同时覆盖 body, 且调用方必须在 tools 清单里
// 事先看到过该工具名 —— 但服务端不做白名单, 授权靠 PEER_SHARED 共享范围控制。
post "/peer/invoke", (req) => {
  let body = str(get(req, "body", ""));
  let v = peer.verify(req, "POST", "POST " + peer.path_only(req.path) + "\n" + body);
  if (!get(v, "ok", false)) {
    return { ok: false, unauthorized: true, error: get(v, "error", "") };
  }
  let parsed = try(() => json(body));
  if (parsed.err != null) {
    return { ok: false, error: "body 不是合法 JSON" };
  }
  let tool_name = str(get(parsed.ok, "tool", ""));
  if (len(tool_name) == 0) {
    return { ok: false, error: "缺少 tool 字段" };
  }
  // 白名单: 写/执行类动作不在 peer 面开放(见文件上方说明)。拒绝信息明说
  // 原因, 否则对端只看到"调用失败", 不知道是策略拦的还是工具不存在。
  let why = policy.deny_reason(tool_name);
  if (len(why) > 0) {
    return { ok: false, denied: true, node: peer.node_info()["name"],
             from: get(v, "node", ""), "tool": tool_name, error: why };
  }
  // arguments 原样透传(已是 JSON 对象时 stringify 回去, 保证是合法 JSON 文本)
  let args_val = get(parsed.ok, "arguments", null);
  let args_json = "{}";
  if (args_val != null) { args_json = stringify(args_val); }

  let r = agent.invoke_tool(tool_name, args_json);
  return {
    ok: get(r, "ok", false),
    node: peer.node_info()["name"],
    from: get(v, "node", ""),
    "tool": tool_name,
    result: get(r, "result", ""),
    error: get(r, "error", ""),
    agent_status: get(r, "status", 0),
  };
};

post "/peer/ask", (req) => {
  let body = str(get(req, "body", ""));
  let v = peer.verify(req, "POST", "POST " + peer.path_only(req.path) + "\n" + body);
  if (!get(v, "ok", false)) {
    return { ok: false, unauthorized: true, error: get(v, "error", "") };
  }
  let parsed = try(() => json(body));
  if (parsed.err != null) {
    return { ok: false, error: "body 不是合法 JSON" };
  }
  let question = str(get(parsed.ok, "question", ""));
  if (len(question) == 0) {
    return { ok: false, error: "缺少 question 字段" };
  }
  let session_id = str(get(parsed.ok, "sessionId", ""));

  // 转发给本机 agent(http-httpd 的 SSE 端点, 由 agent.lume 整体收 + 解析)
  let a = agent.ask(question, session_id);
  return {
    ok: get(a, "ok", false),
    node: peer.node_info()["name"],
    from: get(v, "node", ""),
    question: question,
    answer: get(a, "answer", ""),
    notes: get(a, "notes", []),
    error: get(a, "error", ""),
    // complete=false 说明 SSE 没收到 done, 回答可能被截断(超时/max_bytes)
    complete: get(a, "complete", false),
    events: get(a, "events", 0),
    agent_status: get(a, "status", 0),
  };
};

// 本机 agent 是否可达 —— 让对端能在调用前先判断, 而不是拿到一个空回答
get "/peer/agent", (req) => {
  let v = peer.verify(req, "GET", "GET " + peer.path_only(req.path));
  if (!get(v, "ok", false)) {
    return { ok: false, unauthorized: true, error: get(v, "error", "") };
  }
  let p = agent.ping();
  return {
    ok: true,
    node: peer.node_info()["name"],
    endpoint: agent.endpoint(),
    agent_ok: get(p, "ok", false),
    agent_status: get(p, "status", 0),
    agent_error: get(p, "error", ""),
  };
};

// ══════════════════════════════════════════════════════════════════
// A2A 兼容接口(与 lume-blog 同一套规范, 见 lume-blog/peer_node.lume)
// ══════════════════════════════════════════════════════════════════

get "/.well-known/agent-card.json", (req) => {
  // 本节点背后是 agent-httpd, 能力来自它的 MCP 注册表; agent 没起时空清单。
  let t = agent.list_tools();
  let raw = get(t, "tools", []);
  let tools = [];
  let i = 0;
  while (i < len(raw)) {
    let d = get(raw, i, {});
    let nm = str(get(d, "name", ""));
    if (len(nm) > 0) {
      push(tools, { name: nm, desc: str(get(d, "desc", "")),
                    when_to_use: when_hint(nm) });
    }
    i = i + 1;
  }
  return a2a.card(
    peer.node_info()["name"],
    "局域网设备看板 + 本机 agent 的工具集。问局域网设备/流量/DNS, 或需要本机文件、" +
    "记忆、投资体检能力时用这里。它背后是一个会推理的 agent, 不是固定查询。",
    tools, "/a2a", true);
};

post "/a2a", (req) => {
  let body = str(get(req, "body", ""));
  let parsed = try(() => json(body));
  if (parsed.err != null) {
    return { jsonrpc: "2.0", id: null, error: { code: -32700, message: "parse error" } };
  }
  let rpc = parsed.ok;
  let mid = get(rpc, "id", null);
  let method = str(get(rpc, "method", ""));

  // ---- message/stream: SSE 事件流 ----
  //
  // Card 里声明了 streaming:true, **必须真的实现** —— 谎报会让客户端
  // 等一条永远不来的流(探针报 "未启用流式, 建议 card 里 streaming=false")。
  //
  // 与 crm/scanner 同一套: 同步执行 + 一次性回放事件。lan 背后是 agent,
  // 所以事件在 agent 答完后一次性生成; 语义正确(同样的序列), 但没有
  // "边跑边看" —— lume 没有异步原语, 这是已知限制。
  if (method == "message/stream" or method == "message/streaming") {
    let params = get(rpc, "params", {});
    let q = a2a.message_text(params);
    if (len(q) == 0) {
      return { jsonrpc: "2.0", id: mid,
               error: { code: -32602, message: "params.message.parts 里没有 text" } };
    }
    let ctx = str(get(params, "contextId", ""));
    if (len(ctx) == 0) { ctx = peer.new_message_id(); }
    let tid = peer.new_task_id();

    let events = [];
    push(events, stringify({ jsonrpc: "2.0", id: mid,
      result: { taskId: tid, contextId: ctx, kind: "status-update",
                status: { state: "working", timestamp: str(now()) }, "final": false } }));

    let r0 = agent.ask(q, ctx);
    if (!get(r0, "ok", false)) {
      push(events, stringify({ jsonrpc: "2.0", id: mid,
        result: { taskId: tid, contextId: ctx, kind: "status-update",
                  status: { state: "failed", timestamp: str(now()),
                            message: { role: "agent", parts: [{ kind: "text",
                              text: "agent 不可达: " + str(get(r0, "error", "")) }] } },
                  "final": true } }));
      return { sse: events };
    }
    push(events, stringify({ jsonrpc: "2.0", id: mid,
      result: { taskId: tid, contextId: ctx, kind: "artifact-update",
                artifact: { artifactId: peer.new_message_id(),
                            parts: [{ kind: "text", text: str(get(r0, "answer", "")) }] },
                append: false, lastChunk: true } }));
    push(events, stringify({ jsonrpc: "2.0", id: mid,
      result: { taskId: tid, contextId: ctx, kind: "status-update",
                status: { state: "completed", timestamp: str(now()) }, "final": true } }));
    return { sse: events };
  }

  if (method == "message/send" or method == "tasks/send") {
    let params = get(rpc, "params", {});
    let q = a2a.message_text(params);
    if (len(q) == 0) {
      return { jsonrpc: "2.0", id: mid,
               error: { code: -32602, message: "params.message.parts 里没有 text" } };
    }
    let ctx = str(get(params, "contextId", ""));
    if (len(ctx) == 0) { ctx = peer.new_message_id(); }

    // ---- 多轮续发(与 lume-blog 同一套) ----
    let resume_id = str(get(params, "id", ""));
    if (len(resume_id) > 0) {
      let existing = tasks.load(resume_id);
      if (existing == null) {
        return { jsonrpc: "2.0", id: mid,
                 error: { code: -32001, message: "task not found: " + resume_id } };
      }
      let est = str(get(get(existing, "status", {}), "state", ""));
      if (est == "completed" or est == "failed" or est == "canceled" or est == "rejected") {
        // 任务不可变性: 追问要开新任务
        return { jsonrpc: "2.0", id: mid,
                 error: { code: -32004,
                          message: "任务已终结(" + est + "), 不可恢复; " +
                                   "请在同一 contextId 下发起新任务" } };
      }
      tasks.append_message(resume_id, "user", q);
      if (est == "input-required") {
        tasks.transition_msg(resume_id, "submitted", get(existing, "artifacts", []), "");
      }
      return { jsonrpc: "2.0", id: mid, result: tasks.load(resume_id) };
    }

    let tid = peer.new_task_id();

    // ---- 异步模式: 只落 submitted, 由宿主 worker 推进 ----
    //
    // 与 crm/scanner 同一套语义: `configuration.async=true` 表示"已受理,
    // 稍后取结果"。不能在这里同步算完再标 completed —— 那样调用方的轮询
    // 永远看不到 working, tasks/cancel 也永远返回 -32002。
    //
    // lan 的 worker 由 lume-lan 的 a2a_worker.py 承担(与 blog 共用一个);
    // payload 按 worker 认识的约定落盘。
    let cfg = get(params, "configuration", {});
    let want_async = get(cfg, "async", false) == true;
    if (want_async) {
      let pl = get(params, "payload", null);
      if (pl == null) {
        pl = { kind: "dispatch", target: str(get(cfg, "target", "")), question: q };
      }
      let created = tasks.create(tid, ctx, pl);
      return { jsonrpc: "2.0", id: mid, result: created };
    }

    // 本节点的特殊之处: 背后是 agent, 直接转发(会真的推理与调工具)
    let r = agent.ask(q, ctx);
    if (!get(r, "ok", false)) {
      // agent 不可达 -> failed, 不编造答案
      return { jsonrpc: "2.0", id: mid, result: a2a.task(
        tid, ctx, "failed",
        [a2a.text_artifact(peer.new_message_id(),
          "agent 不可达: " + str(get(r, "error", "")))]) };
    }
    return { jsonrpc: "2.0", id: mid, result: a2a.task(
      tid, ctx, "completed",
      [a2a.text_artifact(peer.new_message_id(), str(get(r, "answer", "")))]) };
  }

  // ---- 长任务: 查状态 / 取消(与 lume-blog 同一套, 见其 peer_node.lume) ----
  if (method == "tasks/get" or method == "GetTask") {
    let params = get(rpc, "params", {});
    let tid = str(get(params, "id", ""));
    if (len(tid) == 0) {
      return { jsonrpc: "2.0", id: mid,
               error: { code: -32602, message: "params.id 必填" } };
    }
    let t = tasks.load(tid);
    if (t == null) {
      return { jsonrpc: "2.0", id: mid,
               error: { code: -32001, message: "task not found: " + tid } };
    }
    return { jsonrpc: "2.0", id: mid, result: t };
  }

  if (method == "tasks/cancel" or method == "CancelTask") {
    let params = get(rpc, "params", {});
    let tid = str(get(params, "id", ""));
    let t = tasks.load(tid);
    if (t == null) {
      return { jsonrpc: "2.0", id: mid,
               error: { code: -32001, message: "task not found: " + tid } };
    }
    let st = str(get(get(t, "status", {}), "state", ""));
    if (st == "completed" or st == "failed" or st == "canceled") {
      return { jsonrpc: "2.0", id: mid,
               error: { code: -32002, message: "task not cancelable (state=" + st + ")" } };
    }
    return { jsonrpc: "2.0", id: mid,
             result: tasks.transition(tid, "canceled", get(t, "artifacts", [])) };
  }
  return { jsonrpc: "2.0", id: mid,
           error: { code: -32601, message: "method not found: " + method } };
};

run();
