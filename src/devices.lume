// lan/src/devices.lume — 领域层:读 .data/devices.json 快照 + 组装响应
//
// 纯无状态:快照由宿主 scripts/scan_lan.py(make scan)原子写,本层只读。
// lume-core 的 read_file() 文件缺失静默返回 null(不报错),据此优雅降级为
// 「暂无快照」提示,而非 500。

let snap_path = ".data/devices.json";
// 路由器后台抓取的快照(宿主 scripts/router_fetch.py → .data/router.json)。
// 缺文件/损坏 → null,前端据此隐藏「路由器」区(优雅降级,不影响 arp 快照)。
let router_path = ".data/router.json";
// 本地设备命名层(.data/aliases.json):{ip: 名字}。对「路由器没给好名字 / 想在
// 本地覆盖」的设备显示本地别名(最高优先级, 不依赖路由器登录态)。缺文件 → 空表。
let aliases_path = ".data/aliases.json";
// 每设备流量历史精简 payload(宿主 router_fetch.py 每轮生成; 全量 420KB 超出
// Lume 响应上限会被截断, 故不下发全量)。单独一个端点 /api/router-traffic 惰性读它。
let hist_path = ".data/router_traffic_payload.json";
// DNS 域名访问记录(.data/dns.json, 宿主 make dns-fetch 轮询 AdGuard Home 产出)。
// 惰性单独端点 /api/dns; AdGuard 没跑 → 快照 reachable=false, 前端显示「未连接」。
let dns_path = ".data/dns.json";
// 可互访的 lume peer 节点(.data/peers.json, 宿主 scripts/peers_fetch.py 产出)。
// 与 devices/router/dns 同一套「宿主采集 → 容器只读」分工: 容器在 Docker NAT
// 网段里连不到宿主 loopback 上的 peer 端口, 所以探测放在宿主, 这里只读快照。
import "approvals.lume" as approvals;

let peers_path = ".data/peers.json";
// 快照「过期」阈值(秒):超过就提示前端重新 make scan。可经 env 覆盖。
let stale_secs = env("LAN_STALE_SECS");
if (stale_secs == null) { stale_secs = "300"; }

// 异常流量告警阈值(GB/近 1h):可经 env 覆盖, 默认 10。
let anomaly_gb_str = env("LAN_ANOMALY_GB");
if (anomaly_gb_str == null) { anomaly_gb_str = "10"; }

// 读并解析快照;文件缺失/JSON 损坏 → 返回 null。
func load_snapshot() {
  let txt = read_file(snap_path);
  if (txt == null) { return null; }
  let r = try(() => json(txt));
  if (r.err != null) { return null; }
  return r.ok;
}

// 读本地命名层({ip: 名字});缺失/损坏 → 空表(不报错)。
func load_aliases() {
  let txt = read_file(aliases_path);
  if (txt == null) { return {}; }
  let r = try(() => json(txt));
  if (r.err != null) { return {}; }
  if (r.ok == null) { return {}; }
  return r.ok;
}

// 每设备流量历史:读 .data/router_traffic_payload.json(宿主 router_fetch.py 生成的精简版)。
// 惰性单端点读取(不塞进 router.json), 前端点选某台设备看它近 90 分钟流量曲线,
// 或用 hist5h(300 点序列首尾差)做「近 5h」流量排行。
// 注意: 全量 .data/router_traffic_hist.json(≈420KB) 超出 Lume 响应上限(约 256KB)会被
// 截断导致前端 JSON 解析失败, 故不下发全量; 宿主已按 90 点 + hist5h 精简。
// 缺文件/损坏 → { available:false } 优雅降级, 不 500。
export func router_traffic_payload() {
  let txt = read_file(hist_path);
  if (txt == null) {
    return { available: false, note: "暂无流量历史——宿主数据循环跑 10 分钟后才有基线" };
  }
  let r = try(() => json(txt));
  if (r.err != null || r.ok == null) {
    return { available: false, note: "流量历史损坏——重跑 make router-fetch" };
  }
  return r.ok;
}

// DNS 域名访问记录:读 .data/dns.json(宿主 make dns-fetch 轮询 AdGuard Home 产出)。
// 缺文件 → available=false(前端提示「未启用 AdGuard」);reachable=false → 沿用旧数据降级。
export func dns_payload() {
  let txt = read_file(dns_path);
  if (txt == null) {
    return { available: false, reachable: false, error: "缺少 .data/dns.json", note: "未启用 DNS 记录——起 AdGuard(make adguard-up)+ 配设备 DNS 后跑 make dns-fetch" };
  }
  let r = try(() => json(txt));
  if (r.err != null || r.ok == null) {
    return { available: false, reachable: false, error: "dns.json 解析失败", note: "DNS 记录损坏——重跑 make dns-fetch" };
  }
  return {
    available: true,
    reachable: get(r.ok, "reachable", false),
    stale: get(r.ok, "stale", false),
    fetched_at: int(get(r.ok, "fetched_at", 0)),
    window_secs: int(get(r.ok, "window_secs", 3600)),
    query_count: int(get(r.ok, "query_count", 0)),
    client_count: int(get(r.ok, "client_count", 0)),
    clients: get(r.ok, "clients", {}),
    top_domains: get(r.ok, "top_domains", []),
    // 统一数据源状态契约: error 与 note 同源(失败原因), 保留 note 兼容既有前端。
    error: get(r.ok, "error", ""),
    note: get(r.ok, "error", ""),
  };
}

// 设备列表:读快照 + 派生统计(总数/在线数/是否过期)。缺失 → 空表 + 指引文案。
export func devices_payload() {
  let s = load_snapshot();
  let nowts = int(now());
  if (s == null) {
    return {
      ok: true,
      missing: true,
      gateway: "",
      host_ip: "",
      subnet: "",
      scanned_at: 0,
      sweep: false,
      count: 0,
      live_count: 0,
      devices: [],
      // 统一数据源状态契约: reachable/fetched_at/stale/error(与 dns/router 一致)。
      reachable: false,
      fetched_at: 0,
      stale: false,
      error: "缺少 .data/devices.json 快照",
      note: "暂无快照——先在宿主跑 make scan(或 python3 scripts/scan_lan.py)生成 .data/devices.json",
    };
  }
  let devs = get(s, "devices", []);
  let live = 0;
  for (d in devs) {
    if (get(d, "live", false) == true) {
      live = live + 1;
    }
  }
  let age = nowts - int(get(s, "scanned_at", 0));
  if (age < 0) { age = 0; }
  let stale = age > int(stale_secs);
  let note = "";
  if (stale) {
    note = "快照已 " + str(int(age / 60.0)) + " 分钟未刷新,宿主 make scan 可更新";
  }
  return {
    ok: true,
    missing: false,
    gateway: get(s, "gateway", ""),
    host_ip: get(s, "host_ip", ""),
    subnet: get(s, "subnet", ""),
    scanned_at: int(get(s, "scanned_at", 0)),
    sweep: get(s, "sweep", false),
    count: len(devs),
    live_count: live,
    devices: devs,
    // 统一数据源状态契约: reachable/fetched_at(快照生成时刻)/stale/error。
    reachable: get(s, "reachable", true),
    fetched_at: int(get(s, "fetched_at", get(s, "scanned_at", 0))),
    stale: stale,
    error: get(s, "error", ""),
    note: note,
  };
}

// 元信息:网关 / 网段 / 快照时间 / 是否可用(前端据此显示刷新提示)。
export func meta_payload() {
  let s = load_snapshot();
  if (s == null) {
    return { gateway: "", host_ip: "", subnet: "", sweep: false, scanned_at: 0,
             reachable: false, fetched_at: 0, available: false };
  }
  return {
    gateway: get(s, "gateway", ""),
    host_ip: get(s, "host_ip", ""),
    subnet: get(s, "subnet", ""),
    sweep: get(s, "sweep", false),
    scanned_at: int(get(s, "scanned_at", 0)),
    // 统一数据源状态契约(vs dns/router): reachable/fetched_at。
    reachable: get(s, "reachable", true),
    fetched_at: int(get(s, "fetched_at", get(s, "scanned_at", 0))),
    available: true,
  };
}

// 路由器后台信息:读 .data/router.json(宿主 router_fetch.py 产出)。
// router.ok = deviceinfo 免密是否成功;router_devices = 登录态抓到的终端/流量
// (可能为空,前端据 terminal_source 与 router_devices 长度决定显示)。
export func router_payload() {
  let txt = read_file(router_path);
  if (txt == null) {
    return { available: false, note: "暂无路由器数据——宿主跑 make router-fetch 生成 .data/router.json" };
  }
  let r = try(() => json(txt));
  if (r.err != null) {
    return { available: false, note: "router.json 损坏——重跑 make router-fetch" };
  }
  let ro = r.ok;
  let router = get(ro, "router", {});
  let rdevs = get(ro, "router_devices", []);
  let login = get(ro, "login", {});
  let login_stale = get(login, "stale", false);
  let login_stale_note = get(login, "stale_note", "");
  let online_count = 0;
  for (d in rdevs) {
    if (get(d, "online", false) == true) {
      online_count = online_count + 1;
    }
  }
  return {
    available: true,
    host: get(router, "host", ""),
    model: get(router, "model", ""),
    friendly: get(router, "friendly", ""),
    serial: get(router, "serial", ""),
    manufacturer_oui: get(router, "manufacturer_oui", ""),
    router_ok: get(router, "ok", false),
    terminal_source: get(ro, "terminal_source", ""),
    login_ok: get(login, "ok", false),
    login_error: get(login, "error", ""),
    login_stale: login_stale,
    login_stale_note: login_stale_note,
    fetched_at: int(get(router, "fetched_at", 0)),
    // 统一数据源状态契约(与 dns/devices 一致): reachable = deviceinfo 可达,
    // stale = 沿用上次终端数据, error = 登录/身份层失败原因。
    reachable: get(ro, "reachable", get(router, "ok", false)),
    stale: get(ro, "stale", login_stale),
    error: get(ro, "error", ""),
    router_devices: rdevs,
    router_count: len(rdevs),
    router_online: online_count,
    router_active: int(get(ro, "router_active", 0)),
    router_traffic_total: get(ro, "router_traffic_total", []),
    // 本地命名层(.data/aliases.json): {ip: 名字}。前端显示时优先级最高,
    // 覆盖路由器备注(ActualName)与设备自报(HostName), 且不依赖登录态。
    router_aliases: load_aliases(),
    // WAN 状态卡(ntwk/wan: 连接态/接入方式/IPv4/IPv6/DNS/NAT 类型/带宽峰值)。
    router_wan: get(ro, "router_wan", {}),
    // 信号强度拓扑(device/topology: mac→{rssi,link_quality,access_type})。
    router_topology: get(ro, "router_topology", {}),
    // 异常流量告警阈值(GB/近 1h, 前端据此标「谁在猛传」; env LAN_ANOMALY_GB 覆盖, 默认 10)。
    anomaly_gb: int(anomaly_gb_str),
  };
}

// 可互访的 lume 应用:读 .data/peers.json(宿主 peers_fetch.py 探测产出)。
// 缺文件 → available=false(提示去配 PEER_SHARED / PEER_TARGETS), 不 500。
// 给待办补"轮到我了吗"。字段命名与 /api/approve 返回保持一致,
// 前端只读不算, 判定权仍在服务端。
func annotate(list) {
  let me = env("PEER_NAME");
  if (me == null) { me = ""; }
  let out = [];
  let i = 0;
  while (i < len(list)) {
    let t = get(list, i, {});
    let chain = get(t, "policy", []);
    let done_list = [];
    let approved = get(t, "approved", []);
    let k = 0;
    while (k < len(approved)) {
      push(done_list, { role: str(get(approved, k, "")), decision: "approve" });
      k = k + 1;
    }
    let st = approvals.next_role(chain, done_list);
    let need_node = str(st.node);
    // 能批的三个条件: 链没完、这一关有具体节点(node 为空=人工终审)、
    // 那个节点就是我。任一不满足都给 false 并说明原因。
    let mine = (not st.done) and len(need_node) > 0 and need_node == me;
    let why = "";
    if (st.done) { why = "审批链已终结"; }
    else if (len(need_node) == 0) { why = "人工终审, 看板不代办"; }
    else if (need_node != me) { why = "等 " + need_node + " 审"; }
    push(out, put(put(put(t, "can_act", mine), "next_node", need_node),
                  "blocked_reason", why));
    i = i + 1;
  }
  return out;
}

// 容器内发往执行方用的地址覆盖。留空时由调用方按 loopback 规则改写。
func container_target(): string {
  let v = env("PEER_CONTAINER_TARGET");
  if (v == null) { return ""; }
  return v;
}

// 按 target 逐项改写(容器内用)。格式: "127.0.0.1:18102=crm-peer:18102,..."
//
// 为什么需要逐项: 一个 PEER_CONTAINER_TARGET 只能覆盖**一个**目标, 而看板
// 同时探多个节点(blog/crm/scanner)。真实场景是"一部分节点在共享 Docker 网
// 里按别名访问, 另一部分在宿主"。逐项映射能表达这种混合, 单一值不能。
//
// 找不到映射就返回空串, 由调用方回退到 loopback 规则(host.docker.internal)。
export func map_target(t: string): string {
  let raw = env("PEER_CONTAINER_TARGETS");
  if (raw == null) { return ""; }
  let parts = str_match("[^,]+", raw);
  let i = 0;
  while (i < len(parts)) {
    let one = str(get(get(parts, i, {}), "text", ""));
    let m = str_match("^([^=]+)=(.+)$", one);
    if (len(m) > 0) {
      let g = get(get(m, 0, {}), "groups", []);
      let from = str(get(g, 0, ""));
      let to = str(get(g, 1, ""));
      if (len(from) > 0 and from == t) { return to; }
    }
    i = i + 1;
  }
  return "";
}

// 安全地取一个字符串字段。
//
// 为什么需要它: lume 的 str(null) 返回**字面量 "null"**(4 个字符), 不是空串。
// 于是 `len(str(get(m, "k", ""))) > 0` 在字段为 null 时恒为真 —— 这个坑
// 让 container_target 被当成有效值 "null", 目标地址被改写成一个不存在的主机。
// 凡是"可能为 null 的字符串"都走这里, 不要直接 str(get(...))。
export func s_or_empty(v) {
  if (v == null) { return ""; }
  let t = str(v);
  if (t == "null") { return ""; }
  return t;
}

// 只把 peers.json 读成 map。审批路径要它, 但**不能**用 peers_payload():
// 后者会顺带跑 annotate 等一堆只给界面看的东西, 在请求处理器里重复做一遍
// 既浪费又容易在 workers>1 时踩到共享文件的读写竞争(实测表现为请求超时)。
export func peers_snapshot() {
  let txt = read_file(peers_path);
  if (txt == null) { return null; }
  let r = try(() => json(txt));
  if (r.err != null || r.ok == null) { return null; }
  return r.ok;
}

export func peers_payload() {
  let txt = read_file(peers_path);
  if (txt == null) {
    return { available: false, enabled: false, reachable: false,
             error: "缺少 .data/peers.json",
             note: "未探测 peer 节点——在 .env 配 PEER_SHARED + PEER_TARGETS 后跑 make peers-fetch" };
  }
  let r = try(() => json(txt));
  if (r.err != null || r.ok == null) {
    return { available: false, enabled: false, reachable: false,
             error: "peers.json 解析失败", note: "快照损坏——重跑 make peers-fetch" };
  }
  let ps = get(r.ok, "peers", []);
  let fetched = int(get(r.ok, "fetched_at", 0));
  let age = int(now()) - fetched;
  if (age < 0) { age = 0; }
  let stale = age > int(stale_secs);
  return {
    available: true,
    enabled: get(r.ok, "enabled", false),
    reachable: true,
    stale: stale,
    age_secs: age,
    fetched_at: fetched,
    targets: get(r.ok, "targets", []),
    up_count: int(get(r.ok, "up_count", 0)),
    // 待办审批 + 审计: 采集侧(peers_fetch.py)从 PEER_STATE_DIRS 读取执行方的
    // 任务与审计文件。未配置来源时为空数组, 前端据此显示"无"而不是报错。
    // 每条待办补一个 can_act: "这一关是否轮到本节点"。UI 据此决定给不给
    // 批准/驳回按钮 —— 判定规则只在服务端写一份(approvals.next_role),
    // 前端不复刻, 否则两边规则一旦漂移就会出现"按钮能点但请求被拒"。
    pending: annotate(get(r.ok, "pending", [])),
    audit: get(r.ok, "audit", []),
    state_dirs: get(r.ok, "state_dirs", []),
    // 容器内的出站地址覆盖(空 = 由 approvals 按 loopback 规则自动改写)。
    // 与 PEER_CONTAINER_TARGETS 同名, 让"宿主怎么探测"和"容器怎么发"两件事
    // 可以分开配, 而不是把宿主地址硬塞进容器去碰运气。
    container_target: container_target(),
    total_count: int(get(r.ok, "total_count", 0)),
    peers: ps,
    error: get(r.ok, "error", ""),
    note: get(r.ok, "error", ""),
  };
}
